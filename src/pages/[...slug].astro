---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { formatDate, getPosts, toXmlSchema, type Post } from '../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.path },
    // Like Jekyll's related_posts without LSI: the most recent other posts.
    props: { post, related: posts.filter((p) => p !== post).slice(0, 2) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  related: Post[];
}

const { post, related } = Astro.props;
const { Content } = await render(post.entry);
---

<BaseLayout
  title={post.title}
  article={{
    url: post.url,
    description: post.description,
    image: post.featuredImage,
    imageAlt: post.featuredImageAlt,
  }}
>
  <article class="post">
    <PageHead title={post.title} reading>
      <time slot="label" datetime={toXmlSchema(post.date)}>{formatDate(post.date)}</time>
    </PageHead>
    <div class="page-body page-body--reading">
      <div class="page-body__inner post-body">
        <Content />
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <aside class="page-body page-body--reading related" aria-labelledby="related-title">
        <div class="page-body__inner">
          <h2 id="related-title" class="label related__title">
            Related posts
          </h2>
          <ul class="related__list" role="list">
            {related.map((r) => (
              <li>
                <a class="card related-card" href={r.url}>
                  <img src={r.featuredImage} alt="" />
                  <span class="related-card__body">
                    <span class="label">{r.category}</span>
                    <span class="related-card__title">{r.title}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )
  }
</BaseLayout>
