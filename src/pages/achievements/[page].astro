---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccomplishmentsPage from '../../components/AccomplishmentsPage.astro';
import { getAccomplishments } from '../../lib/accomplishments';
import { paginate } from '../../lib/pagination';
import { site } from '../../site';

// Pages 2+, like the blog's: /achievements/page2/, /achievements/page3/, ...
// Locked achievements are listed on page 1 only, and counted on every page.
export const getStaticPaths = (() => {
  const { done, locked } = getAccomplishments();
  return paginate(done, site.accomplishmentsPerPage)
    .slice(1)
    .map((props) => ({ params: { page: `page${props.page}` }, props: { ...props, locked } }));
}) satisfies GetStaticPaths;
---

<BaseLayout title="Achievements">
  <AccomplishmentsPage {...Astro.props} />
</BaseLayout>
