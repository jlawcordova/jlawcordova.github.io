---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListItem from '../components/PostListItem.astro';
import { getPosts } from '../lib/posts';

const recentPosts = (await getPosts()).slice(0, 3);
---

<BaseLayout>
  <section class="intro-container content">
    <div class="intro">
      <header>
        <p class="pretitle">Hi I'm</p>
        <h1>J. Law. Cordova.</h1>
        <p>
          I make <span class="highlighted-skill"><span class="skill shown">Enterprise Applications </span><span class="skill hidden">Backend Systems </span><span class="skill hidden">Automated Pipelines</span></span>.
        </p>
      </header>
      <p class="subheader">
        Software design and development is my craft. I make it a mission to deliver valuable and well-architected systems in the web.
      </p>
    </div>
    <img id="cogs" src="/public/jlawcordova-cogs.svg" alt="animated cogs" />
  </section>

  <section class="bio-container">
    <div class="bio-content-container">
      <h2>Code <span class="heading-highlight">+</span> Create</h2>
      <p class="bio-content">
        As a computer engineer who likes to solve problems, I found passion in writing code and continuously learning in a fast-paced field. This has allowed me to create useful software in various industries.
      </p>
      <br />
      <p class="bio-content">
        Nowadays, I mostly work on backend systems, aiming to create engaging user and developer experiences through clear documentation, automated workflows and well-designed architectures.
      </p>
    </div>
  </section>

  {
    recentPosts.length > 0 && (
      <section class="recent-blogs-section-container">
        <div class="recent-blogs-section-wrapper">
          <h2 class="recent-blogs-heading">Recent Blog Posts</h2>
          <ol class="posts-container">
            {recentPosts.map((post) => (
              <PostListItem post={post} />
            ))}
          </ol>
          <div class="view-all-container">
            <a href="/blog" class="view-all">View all</a>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  // Cycle through the highlighted skills in the intro.
  const skills = document.querySelectorAll('.skill');
  let current = 1;

  setInterval(() => {
    skills.forEach((skill) => {
      skill.classList.remove('shown');
      skill.classList.add('hidden');
    });
    skills[current].classList.add('shown');
    skills[current].classList.remove('hidden');
    current = (current + 1) % skills.length;
  }, 2600);
</script>
