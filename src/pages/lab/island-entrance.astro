---
// The entrance lab (island clock sweep spec R8): an unlisted page for trying
// other build-ups on the hero island, played by the same schedule and player
// as the home page. How to use it, and how to ship a choice:
// .claude/skills/pixel-art-motion/SKILL.md.
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroIsland from '../../components/home/HeroIsland.astro';
import EntranceLab from '../../components/lab/EntranceLab.astro';
---

<BaseLayout title="Entrance lab" noindex>
  <section class="entrance-page">
    <div class="entrance-page__intro">
      <p class="label">Lab</p>
      <h1>Entrance lab</h1>
      <p>Try other orders and moves for the hero island's build-up. Anything you change replays at once.</p>
    </div>
    <div class="entrance-page__grid">
      <div class="entrance-stage isogrid">
        <div class="floaty">
          <HeroIsland />
        </div>
      </div>
      <EntranceLab />
    </div>
  </section>
</BaseLayout>

<style>
  .entrance-page {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: calc(var(--header-offset) + 16px) var(--gutter) 64px;
  }
  .entrance-page__intro {
    margin-bottom: 24px;
  }
  .entrance-page__intro h1 {
    margin: 0 0 8px;
  }
  .entrance-page__intro p:last-child {
    margin: 0;
    color: var(--color-ink-muted);
  }
  .entrance-page__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 24px;
    align-items: start;
  }
  .entrance-stage {
    display: flex;
    justify-content: center;
    padding: 48px 16px;
    background-color: var(--color-hero);
    border: var(--border-thick);
    border-radius: var(--radius-stage);
  }
  @media (max-width: 900px) {
    .entrance-page__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
