---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
---

<BaseLayout title="404: Page not found">
  <PageHead title="404: Page not found" reading />
  <div class="page-body page-body--reading">
    <div class="page-body__inner not-found">
      <p>Sorry, we’ve misplaced that URL or it’s pointing to something that doesn’t exist.</p>
      <a class="btn btn--primary" href="/">Head back home</a>
    </div>
  </div>
</BaseLayout>
