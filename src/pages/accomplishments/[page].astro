---
import type { GetStaticPaths } from 'astro';
import { getAccomplishments } from '../../lib/accomplishments';
import { paginate } from '../../lib/pagination';
import { site } from '../../site';

// /accomplishments/page2/, ... moved to /achievements/page2/, ... (achievements
// redesign spec R18), written as refresh pages like index.astro here. Its own
// page, not a `redirects` entry in astro.config.mjs, because a dynamic config
// redirect drops the trailing slash and so needs a second hop.
export const getStaticPaths = (() => {
  return paginate(getAccomplishments().done, site.accomplishmentsPerPage)
    .slice(1)
    .map(({ page }) => ({ params: { page: `page${page}` } }));
}) satisfies GetStaticPaths;

return Astro.redirect(`/achievements/${Astro.params.page}/`, 301);
---
