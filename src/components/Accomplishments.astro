---
// The home page's achievements (gamified accomplishments spec R5, R6, R8;
// achievements redesign spec R1–R7, R11–R16): the three newest done, the newest
// locked, and "View all" when the full list at /achievements/ has anything
// else, then the "Achievement unlocked!" toast for the newest earned one, gold
// under ink in both themes (data-theme="light", as the Range handheld).
// Nothing renders without data. Two columns above 720px (pixel-first look
// spec, Accomplishments): the heading, subtitle, tally and "View all" on the
// left, the rows on the right. "View all" stays after the list in the DOM, so
// it sits under the rows when they stack.
import AccomplishmentRow from './AccomplishmentRow.astro';
import AchievementIcon from './AchievementIcon.astro';
import AchievementIcons from './AchievementIcons.astro';
import AchievementTally from './AchievementTally.astro';
import { formatDateRange, getAccomplishments, homeSelection, rowFor } from '../lib/accomplishments';

const all = getAccomplishments();
const { visible, done, locked, showMore } = homeSelection(all);
const shown = locked ? [...done, locked] : done;
const newest = done[0];
const toast = newest && { ...rowFor(newest), date: formatDateRange(newest) };

// A 6×6 pixel "×".
const CROSS = 'M0 0h1v1h-1zM5 0h1v1h-1zM1 1h1v1h-1zM4 1h1v1h-1zM2 2h2v2h-2zM1 4h1v1h-1zM4 4h1v1h-1zM0 5h1v1h-1zM5 5h1v1h-1z';
---

{
  visible && (
    <section id="achievements" class="accomplishments" aria-labelledby="achievements-title">
      <AchievementIcons />
      <div class="accomplishments__inner">
        <h2 id="achievements-title" class="accomplishments__title" tabindex="-1">
          Achievements
        </h2>
        <p class="accomplishments__lede">I keep a log of my recent work. Here’s what I’ve been up to lately.</p>
        <div class="accomplishments__tally">
          <AchievementTally earned={all.done.length} locked={all.locked.length} />
        </div>
        <ol class="achievement-list" role="list">
          {shown.map((item) => (
            <AccomplishmentRow item={item} latest={item === newest} />
          ))}
        </ol>
        {showMore && (
          <a class="btn btn--ghost accomplishments__more" href="/achievements/">
            View all<span class="visually-hidden"> achievements</span>
          </a>
        )}
      </div>
      {toast && (
        <div class="achievement-toast" role="status">
          <div class="achievement-toast__card" data-theme="light" hidden>
            <AchievementIcon icon={toast.icon} frame={toast.frame} />
            <p class="achievement-toast__text">
              <span class="achievement-toast__label">Achievement unlocked!</span>
              <span class="achievement-toast__name">{toast.lead}</span>
              <span class="achievement-toast__line">{toast.short ? `${toast.short} · ${toast.date}` : toast.date}</span>
            </p>
            <button class="achievement-toast__close" type="button" aria-label="Close">
              <svg class="pixel-art" viewBox="0 0 6 6" width="15" height="15" aria-hidden="true" focusable="false">
                <path fill="currentColor" d={CROSS} />
              </svg>
            </button>
          </div>
        </div>
      )}
    </section>
  )
}

<script>
  // Rows still below the fold rise in as the list scrolls into view (pixel-first
  // look spec, Accomplishments), and each earned frame hops once as its row
  // lands (achievements redesign spec R15). Rows already on screen, and every
  // row without JavaScript or under reduced motion, are never hidden. Then the
  // toast, once a session (R11–R14).
  import { achievementToast } from '../lib/achievement-toast';
  import { hop, reveal } from '../lib/motion';

  const section = document.getElementById('achievements');
  if (section) {
    reveal(section.querySelectorAll('.achievement-list > .achievement'), { y: 16, stagger: 0.06, duration: 0.4 });
    hop(section.querySelectorAll('.achievement[data-state="done"] .achievement__icon'), { delay: 0.4, stagger: 0.06 });
    achievementToast(section);
  }
</script>
