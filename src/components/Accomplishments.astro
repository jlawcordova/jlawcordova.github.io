---
// The home page's accomplishments (gamified accomplishments spec R5, R6, R8):
// the three newest done, the newest locked, and "Show more" when the full list
// at /accomplishments/ has anything else. Nothing renders without data.
// Two columns above 720px (pixel-first look spec, Accomplishments): the
// heading, lede and "Show more" on the left, the rows on the right. "Show more"
// stays after the list in the DOM, so it sits under the rows when they stack.
import AccomplishmentRow from './AccomplishmentRow.astro';
import AchievementIcons from './AchievementIcons.astro';
import { getAccomplishments, homeSelection } from '../lib/accomplishments';

const { visible, done, locked, showMore } = homeSelection(getAccomplishments());
const shown = locked ? [...done, locked] : done;
---

{
  visible && (
    <section id="accomplishments" class="accomplishments" aria-labelledby="accomplishments-title">
      <AchievementIcons />
      <div class="accomplishments__inner">
        <h2 id="accomplishments-title" class="accomplishments__title">
          What I’ve been working on lately
        </h2>
        <p class="accomplishments__lede">A running log of what I’ve shipped recently.</p>
        <ol class="achievement-list" role="list">
          {shown.map((item) => (
            <AccomplishmentRow item={item} />
          ))}
        </ol>
        {showMore && (
          <a class="btn btn--ghost accomplishments__more" href="/accomplishments/">
            Show more<span class="visually-hidden"> accomplishments</span>
          </a>
        )}
      </div>
    </section>
  )
}
