---
// The home page's achievements (gamified accomplishments spec R5, R6, R8;
// achievements redesign spec R1–R7): the three newest done, the newest locked,
// and "View all" when the full list at /achievements/ has anything else.
// Nothing renders without data. Two columns above 720px (pixel-first look
// spec, Accomplishments): the heading, subtitle, tally and "View all" on the
// left, the rows on the right. "View all" stays after the list in the DOM, so
// it sits under the rows when they stack.
import AccomplishmentRow from './AccomplishmentRow.astro';
import AchievementIcons from './AchievementIcons.astro';
import AchievementTally from './AchievementTally.astro';
import { getAccomplishments, homeSelection } from '../lib/accomplishments';

const all = getAccomplishments();
const { visible, done, locked, showMore } = homeSelection(all);
const shown = locked ? [...done, locked] : done;
const newest = done[0];
---

{
  visible && (
    <section id="achievements" class="accomplishments" aria-labelledby="achievements-title">
      <AchievementIcons />
      <div class="accomplishments__inner">
        <h2 id="achievements-title" class="accomplishments__title" tabindex="-1">
          Achievements
        </h2>
        <p class="accomplishments__lede">I keep a log of my recent work. Here’s what I’ve been up to lately.</p>
        <div class="accomplishments__tally">
          <AchievementTally earned={all.done.length} locked={all.locked.length} />
        </div>
        <ol class="achievement-list" role="list">
          {shown.map((item) => (
            <AccomplishmentRow item={item} latest={item === newest} />
          ))}
        </ol>
        {showMore && (
          <a class="btn btn--ghost accomplishments__more" href="/achievements/">
            View all<span class="visually-hidden"> achievements</span>
          </a>
        )}
      </div>
    </section>
  )
}

<script>
  // Rows still below the fold rise in as the list scrolls into view (pixel-first
  // look spec, Accomplishments), and each earned frame hops once as its row
  // lands (achievements redesign spec R15). Rows already on screen, and every
  // row without JavaScript or under reduced motion, are never hidden.
  import { hop, reveal } from '../lib/motion';

  const section = document.getElementById('achievements');
  if (section) {
    reveal(section.querySelectorAll('.achievement'), { y: 16, stagger: 0.06, duration: 0.4 });
    hop(section.querySelectorAll('.achievement[data-state="done"] .achievement__icon'), { delay: 0.4, stagger: 0.06 });
  }
</script>
