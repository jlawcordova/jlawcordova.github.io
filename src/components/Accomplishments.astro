---
import AccomplishmentCard from './AccomplishmentCard.astro';
import { getAccomplishments } from '../lib/accomplishments';

const VISIBLE = 8;
const { status, items } = getAccomplishments();
const shown = items.slice(0, VISIBLE);
const more = items.slice(VISIBLE);
---

{
  status === 'ok' && items.length > 0 && (
    <section id="accomplishments" class="accomplishments" aria-labelledby="accomplishments-title">
      <div class="accomplishments__inner">
        <header class="accomplishments__head">
          <p class="label">Achievements unlocked</p>
          <h2 id="accomplishments-title">Accomplishments</h2>
        </header>
        <ol class="accomplishments__list" role="list">
          {shown.map((item) => (
            <AccomplishmentCard item={item} />
          ))}
        </ol>
        {more.length > 0 && (
          <details class="accomplishments__more">
            <summary class="btn btn--ghost">Show {more.length} more</summary>
            <ol class="accomplishments__list" role="list">
              {more.map((item) => (
                <AccomplishmentCard item={item} />
              ))}
            </ol>
          </details>
        )}
      </div>
    </section>
  )
}
