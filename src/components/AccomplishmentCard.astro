---
import { formatDateRange, linkLabel, type Accomplishment } from '../lib/accomplishments';

interface Props {
  item: Accomplishment;
}

const { item } = Astro.props;

// A 7×7 pixel star, drawn once as a hard ink shadow and once in gold.
const STAR = 'M3 0h1v1h-1zM2 1h3v1h-3zM0 2h7v1h-7zM1 3h5v1h-5zM2 4h3v1h-3zM1 5h2v1h-2zM4 5h2v1h-2zM1 6h1v1h-1zM5 6h1v1h-1z';
// A 7×7 pixel "↗".
const ARROW = 'M2 0h5v1h-5zM3 1h4v1h-4zM4 2h3v1h-3zM3 3h1v1h-1zM5 3h2v1h-2zM2 4h1v1h-1zM6 4h1v1h-1zM1 5h1v1h-1zM0 6h1v1h-1z';
---

<li class="accomplishment card">
  <svg class="accomplishment__badge pixel-art" viewBox="0 0 8 8" width="28" height="28" aria-hidden="true">
    <path fill="var(--color-ink)" transform="translate(1 1)" d={STAR}></path>
    <path fill="var(--color-gold)" d={STAR}></path>
  </svg>
  <div class="accomplishment__body">
    <p class="accomplishment__date">{item.done ? formatDateRange(item) : 'Not done yet'}</p>
    <h3 class="accomplishment__title">{item.title}</h3>
    <p class="accomplishment__description">{item.description}</p>
    {
      item.tags.length > 0 && (
        <ul class="accomplishment__tags" aria-label="Tags">
          {item.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
    {
      item.links.length > 0 && (
        <ul class="accomplishment__links">
          {item.links.map((link) => (
            <li>
              <a href={link} target="_blank" rel="noopener noreferrer">
                {linkLabel(link)}
                <svg class="pixel-art" viewBox="0 0 7 7" width="10" height="10" aria-hidden="true">
                  <path fill="currentColor" d={ARROW} />
                </svg>
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</li>
