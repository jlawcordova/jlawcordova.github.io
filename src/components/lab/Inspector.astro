---
// The right-hand column (spec D9.4, D9.5). Scene mode: the Items list, then
// the Selected and Scene panels (scene-mode.ts). Object mode: the Palette,
// then the Layers, Frames, Object and Preview panels (object-mode.ts and the
// *-panel.ts modules). Each mode's parts carry data-for.
const position = [
  { field: 'col', label: 'Col', name: 'column' },
  { field: 'row', label: 'Row', name: 'row' },
  { field: 'level', label: 'Level', name: 'level' },
];
const offset = [
  { field: 'x', label: 'X', name: 'x' },
  { field: 'y', label: 'Y', name: 'y' },
];
---

<div class="lab__side">
  <section class="lab-panel" id="lab-items">
    <div data-for="scene">
      <h2 class="label lab-panel__title" id="lab-items-title">Items</h2>
      <div class="lab-tree" id="lab-tree" role="tree" tabindex="0" aria-labelledby="lab-items-title"></div>
    </div>
    <div data-for="object" hidden>
      <h2 class="label lab-panel__title" id="lab-palette-title">Palette</h2>
      <div id="lab-palette" role="group" aria-labelledby="lab-palette-title"></div>
      <p class="lab-meter" id="lab-meter" aria-live="polite"></p>
    </div>
  </section>

  <section class="lab-panel" id="lab-inspector">
    <h2 class="visually-hidden" id="lab-inspector-title">Inspector</h2>

    <div class="lab-panel__part" data-for="object" role="group" aria-labelledby="lab-layers-title" hidden>
      <h3 class="label lab-panel__title" id="lab-layers-title">Layers</h3>
      <ol class="lab-layers" id="lab-layers"></ol>
      <div class="lab-actions" id="lab-layer-actions">
        <button type="button" class="btn btn--ghost" data-layer="add">Add layer</button>
      </div>
    </div>

    <div class="lab-panel__part" data-for="object" role="group" aria-labelledby="lab-frames-title" id="lab-frames-part" hidden>
      <h3 class="label lab-panel__title" id="lab-frames-title">Animation</h3>
      <p class="lab-panel__note" id="lab-still-note">This layer is still. Animate it to paint its frames one by one.</p>
      <div class="lab-field" id="lab-loop-field">
        <label for="lab-loop">Loop</label>
        <select id="lab-loop">
          <option value="ff">ff · 4 frames in 0.6 s</option>
          <option value="wf">wf · 5 frames in 1 s</option>
          <option value="hf">hf · 6 frames in 3 s</option>
        </select>
      </div>
      <div class="lab-frames" id="lab-frames" role="group" aria-label="Frames of the layer"></div>
      <div class="lab-frames__play">
        <button type="button" class="lab-step" data-frame="back" aria-label="Previous frame">‹</button>
        <button type="button" class="lab-step lab-step--wide" data-frame="play" aria-pressed="false">Play</button>
        <button type="button" class="lab-step" data-frame="forward" aria-label="Next frame">›</button>
      </div>
      <div class="lab-actions">
        <button type="button" class="btn btn--ghost" data-frame="add">Add frame</button>
        <button type="button" class="btn btn--ghost" data-frame="duplicate">Duplicate frame</button>
        <button type="button" class="btn btn--ghost" data-frame="earlier">Move earlier</button>
        <button type="button" class="btn btn--ghost" data-frame="later">Move later</button>
        <button type="button" class="btn btn--ghost" data-frame="delete">Delete frame</button>
        <button type="button" class="btn btn--ghost" data-frame="animate">Animate this layer</button>
        <button type="button" class="btn btn--ghost" data-frame="still">Stop animating</button>
      </div>
      <p class="lab-panel__note" id="lab-loop-note"></p>
      <div id="lab-poses-part" hidden>
        <h4 class="label lab-panel__title" id="lab-poses-title">Poses</h4>
        <div class="lab-actions" id="lab-poses" role="group" aria-labelledby="lab-poses-title"></div>
      </div>
    </div>

    <div class="lab-panel__part" data-for="object" role="group" aria-labelledby="lab-object-title" hidden>
      <h3 class="label lab-panel__title" id="lab-object-title">Object</h3>
      <dl class="lab-facts" id="lab-object-facts"></dl>
      <div class="lab-fields" id="lab-object-fields"></div>
      <p class="lab-panel__note" id="lab-object-note"></p>
    </div>

    <div class="lab-panel__part" data-for="object" role="group" aria-labelledby="lab-preview-title" hidden>
      <h3 class="label lab-panel__title" id="lab-preview-title">Preview</h3>
      <div class="lab-preview isogrid">
        <canvas id="lab-preview-1" width="1" height="1" aria-hidden="true"></canvas>
        <canvas id="lab-preview-2" width="1" height="1" aria-hidden="true"></canvas>
      </div>
      <p class="lab-panel__note">At 1× and 2×, standing on one tile, at the frame shown.</p>
    </div>

    <div class="lab-panel__part" data-for="scene" aria-labelledby="lab-selected-title" role="group">
      <h3 class="label lab-panel__title" id="lab-selected-title">Selected</h3>
      <p class="lab-panel__note" id="lab-selected-none">Nothing selected. Choose an item in Items or on the stage.</p>
      <div id="lab-selected" hidden>
        <div class="lab-fields" data-placement="tile">
          {
            position.map(({ field, label, name }) => (
              <div class="lab-number">
                <label for={`lab-${field}`}>{label}</label>
                <button type="button" class="lab-step" data-field={field} data-step="-1" aria-label={`Decrease ${name}`}>−</button>
                <input type="number" id={`lab-${field}`} data-field={field} step="1" inputmode="numeric" />
                <button type="button" class="lab-step" data-field={field} data-step="1" aria-label={`Increase ${name}`}>+</button>
              </div>
            ))
          }
        </div>
        <div class="lab-fields" data-placement="px">
          {
            offset.map(({ field, label, name }) => (
              <div class="lab-number">
                <label for={`lab-${field}`}>{label}</label>
                <button type="button" class="lab-step" data-field={field} data-step="-1" aria-label={`Decrease ${name}`}>−</button>
                <input type="number" id={`lab-${field}`} data-field={field} step="1" inputmode="numeric" />
                <button type="button" class="lab-step" data-field={field} data-step="1" aria-label={`Increase ${name}`}>+</button>
              </div>
            ))
          }
        </div>
        <p class="lab-panel__note" id="lab-placement-note"></p>
        <div class="lab-field">
          <label for="lab-class">Class</label>
          <input type="text" id="lab-class" autocomplete="off" spellcheck="false" placeholder="none" />
        </div>
        <div class="lab-actions">
          <button type="button" class="btn btn--ghost" data-item="raise">Raise</button>
          <button type="button" class="btn btn--ghost" data-item="lower">Lower</button>
          <button type="button" class="btn btn--ghost" data-item="snap">Snap to tile</button>
          <button type="button" class="btn btn--ghost" data-item="duplicate">Duplicate</button>
          <button type="button" class="btn btn--ghost" data-item="remove">Remove</button>
        </div>
      </div>
    </div>

    <div class="lab-panel__part" data-for="scene" aria-labelledby="lab-anim-title" role="group" id="lab-anim">
      <h3 class="label lab-panel__title" id="lab-anim-title">Animation</h3>
      <div class="lab-frames__play">
        <button type="button" class="lab-step" data-anim="start" aria-label="Back to the rest frame">«</button>
        <button type="button" class="lab-step lab-step--wide" data-anim="play" aria-pressed="false">Play</button>
      </div>
      <div class="lab-field lab-time">
        <label for="lab-time">Time</label>
        <input type="range" id="lab-time" min="0" max="4000" step="100" value="0" />
        <output id="lab-time-out" for="lab-time">0.0 s</output>
      </div>
      <div class="lab-field">
        <label for="lab-duration">Loop length (s)</label>
        <input type="number" id="lab-duration" min="0.1" step="0.1" inputmode="decimal" />
      </div>
      <p class="lab-panel__note">At 0 s the scene rests, as reduced motion shows it. Past 0 s, moving an animated item on the stage keys it at that time.</p>
      <p class="lab-panel__note" id="lab-track-none">Select an item to animate it.</p>
      <div id="lab-track" hidden>
        <ol class="lab-keys" id="lab-keys" aria-label="Keys"></ol>
        <div class="lab-actions">
          <button type="button" class="btn btn--ghost" data-anim="track">Animate this item</button>
          <button type="button" class="btn btn--ghost" data-anim="key">Add key here</button>
          <button type="button" class="btn btn--ghost" data-anim="untrack">Stop animating</button>
        </div>
      </div>
    </div>

    <div class="lab-panel__part" data-for="scene" aria-labelledby="lab-scene-title" role="group">
      <h3 class="label lab-panel__title" id="lab-scene-title">Scene</h3>
      <dl class="lab-facts" id="lab-scene-facts"></dl>
    </div>
  </section>
</div>
