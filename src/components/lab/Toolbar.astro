---
// The toolbar (spec D9.4, D9.5): the mode switch, each mode's tools and
// zoom, the grid, onion skin, and undo and redo. One tab stop with arrow
// keys inside it (keyboard.ts). Controls for one mode carry data-for and
// hide in the other. Icons are drawn on a 9×9 grid, like the Range chevrons.
const sceneTools = [
  { tool: 'select', label: 'Select', key: 'V', path: 'M1 0h1v8h-1zM2 1h1v6h-1zM3 2h1v4h-1zM4 3h1v3h-1zM5 4h1v1h-1zM4 6h1v2h-1zM5 7h1v2h-1z' },
  { tool: 'place', label: 'Place', key: 'A', path: 'M4 1h1v7h-1zM1 4h3v1h-3zM5 4h3v1h-3z' },
  { tool: 'pan', label: 'Pan', key: 'H', path: 'M4 0h1v9h-1zM0 4h4v1h-4zM5 4h4v1h-4zM3 1h3v1h-3zM3 7h3v1h-3zM1 3h1v3h-1zM7 3h1v3h-1z' },
];
const objectTools = [
  { tool: 'pencil', label: 'Pencil', key: 'B', path: 'M6 0h2v1h1v2h-1v1h-1v1h-1v1h-1v1h-1v1h-3v-3h1v-1h1v-1h1v-1h1v-1h1zM0 8h2v1h-2z' },
  { tool: 'eraser', label: 'Eraser', key: 'E', path: 'M5 1h2v1h1v1h1v2h-1v1h-1v1h-1v1h-4v-1h-1v-2h1v-1h1v-1h1v-1h1zM2 8h6v1h-6z' },
  { tool: 'fill', label: 'Fill', key: 'G', path: 'M3 0h1v1h1v1h1v1h1v1h1v1h-1v1h-1v1h-1v1h-1v-1h-1v-1h-1v-1h-1v-1h-1v-1h1v-1h1v-1h1zM7 6h1v2h-1zM8 7h1v2h-1z' },
  { tool: 'picker', label: 'Picker', key: 'I', path: 'M6 0h2v1h1v2h-1v1h-1v-1h-1zM5 3h1v1h-1v1h-1v1h-1v1h-1v1h-1v1h-2v-2h1v-1h1v-1h1v-1h1v-1h1z' },
];
---

<div class="lab-toolbar" role="toolbar" aria-label="Tools" aria-controls="lab-stage">
  <div class="lab-toolbar__group lab-toolbar__modes">
    <button type="button" class="lab-mode" data-mode="scene" aria-pressed="true">Scene</button>
    <button type="button" class="lab-mode" data-mode="object" aria-pressed="false">Object</button>
  </div>
  <div class="lab-toolbar__group" data-for="scene">
    {
      sceneTools.map(({ tool, label, key, path }) => (
        <button type="button" class="lab-tool" data-tool={tool} aria-pressed="false" aria-label={label} aria-keyshortcuts={key} title={`${label} (${key})`}>
          <svg class="pixel-art" width="27" height="27" viewBox="0 0 9 9" aria-hidden="true">
            <path fill="currentColor" d={path} />
          </svg>
        </button>
      ))
    }
  </div>
  <div class="lab-toolbar__group" data-for="object" hidden>
    {
      objectTools.map(({ tool, label, key, path }) => (
        <button type="button" class="lab-tool" data-paint={tool} aria-pressed="false" aria-label={label} aria-keyshortcuts={key} title={`${label} (${key})`}>
          <svg class="pixel-art" width="27" height="27" viewBox="0 0 9 9" aria-hidden="true">
            <path fill="currentColor" d={path} />
          </svg>
        </button>
      ))
    }
  </div>
  <div class="lab-toolbar__group" data-for="scene">
    {
      ['1', '2', '3', '4'].map((z) => (
        <button type="button" class="lab-tool lab-tool--text" data-zoom={z} aria-pressed="false" aria-label={`Zoom ${z}×`} aria-keyshortcuts={z} title={`Zoom ${z}× (${z})`}>
          {z}×
        </button>
      ))
    }
    <button type="button" class="lab-tool lab-tool--text" data-zoom="fit" aria-pressed="true" aria-label="Zoom to fit" aria-keyshortcuts="0" title="Zoom to fit (0)">Fit</button>
  </div>
  <div class="lab-toolbar__group" data-for="object" hidden>
    {
      ['4', '8', '12', '16'].map((z, i) => (
        <button type="button" class="lab-tool lab-tool--text" data-ozoom={z} aria-pressed="false" aria-label={`Zoom ${z}×`} aria-keyshortcuts={String(i + 1)} title={`Zoom ${z}× (${i + 1})`}>
          {z}×
        </button>
      ))
    }
    <button type="button" class="lab-tool lab-tool--text" data-ozoom="fit" aria-pressed="true" aria-label="Zoom to fit" aria-keyshortcuts="0" title="Zoom to fit (0)">Fit</button>
  </div>
  <div class="lab-toolbar__group">
    <button type="button" class="lab-tool" data-for="scene" data-action="grid" aria-pressed="false" aria-label="Tile grid" title="Tile grid">
      <svg class="pixel-art" width="27" height="27" viewBox="0 0 9 9" aria-hidden="true">
        <path fill="currentColor" d="M2 0h1v9h-1zM6 0h1v9h-1zM0 2h9v1h-9zM0 6h9v1h-9z" />
      </svg>
    </button>
    <button type="button" class="lab-tool" data-for="object" data-action="pixel-grid" aria-pressed="false" aria-label="Pixel grid" title="Pixel grid (from 8×)" hidden>
      <svg class="pixel-art" width="27" height="27" viewBox="0 0 9 9" aria-hidden="true">
        <path fill="currentColor" d="M2 0h1v9h-1zM6 0h1v9h-1zM0 2h9v1h-9zM0 6h9v1h-9z" />
      </svg>
    </button>
    <button type="button" class="lab-tool" data-for="object" data-action="onion" aria-pressed="false" aria-label="Onion skin" title="Onion skin: the previous frame at 30%" hidden>
      <svg class="pixel-art" width="27" height="27" viewBox="0 0 9 9" aria-hidden="true">
        <path fill="currentColor" d="M3 0h3v1h-3zM2 1h1v1h-1zM6 1h1v1h-1zM1 2h1v5h-1zM7 2h1v5h-1zM2 7h1v1h-1zM6 7h1v1h-1zM3 8h3v1h-3zM4 2h1v5h-1z" />
      </svg>
    </button>
    <button type="button" class="lab-tool" data-action="undo" aria-label="Undo" aria-keyshortcuts="Control+Z Meta+Z" title="Undo (Ctrl+Z)">
      <svg class="pixel-art" width="27" height="27" viewBox="0 0 9 9" aria-hidden="true">
        <path fill="currentColor" d="M0 3h1v1h-1zM1 2h1v3h-1zM2 1h1v5h-1zM3 3h4v1h-4zM7 4h1v3h-1zM4 7h3v1h-3z" />
      </svg>
    </button>
    <button type="button" class="lab-tool" data-action="redo" aria-label="Redo" aria-keyshortcuts="Shift+Control+Z Shift+Meta+Z" title="Redo (Shift+Ctrl+Z)">
      <svg class="pixel-art" width="27" height="27" viewBox="0 0 9 9" aria-hidden="true">
        <path fill="currentColor" d="M8 3h1v1h-1zM7 2h1v3h-1zM6 1h1v5h-1zM2 3h4v1h-4zM1 4h1v3h-1zM2 7h3v1h-3z" />
      </svg>
    </button>
  </div>
</div>
