---
// The entrance lab's controls (island clock sweep spec R8): every order, move
// and number of the build-up schedule in src/lib/island-entrance.mjs, played
// on the hero island with the same code as the home page. The Ground and
// Objects tabs each set their own order, timing and move. Changing anything
// replays it; R replays, H hides the controls, and the settings live in the
// URL. Copy gives the changes to TIMING, ready to paste.
import { GROUND_ORDERS, MOVES, OBJECT_MOVES, OBJECT_ORDERS } from '../../lib/island-entrance.mjs';

const label: Record<string, string> = {
  rows: 'Rows, left cliff first',
  cols: 'Columns, back-left first',
  'back-front': 'Back to front',
  'front-back': 'Front to back',
  sweep: 'Sweep, left corner to right',
  ltr: 'Left to right',
  center: 'Ripple out from the middle',
  edges: 'Ripple in from the edges',
  clock: 'Clock sweep from the left corner',
  checker: 'Checkerboard, two waves',
  random: 'Random',
  together: 'All at once',
  same: 'Same as the ground',
  float: 'Float up, overshoot, settle',
  drop: 'Drop from above, dip, settle',
  pop: 'Pop up from its foot',
  stepped: 'Float in whole art pixels',
  fade: 'Fade only',
};
const options = (list: readonly string[]) => list.map((value) => ({ value, text: label[value] }));

type Field =
  | { kind: 'select'; name: string; text: string; options: { value: string; text: string }[]; when?: string }
  | { kind: 'range'; name: string; text: string; min: number; max: number; step: number; unit: string; when?: string };

/** The move's numbers, for the ground (prefix '') or the objects (prefix 'object'), shown when `when` + the move uses them. */
const moveFields = (prefix: '' | 'object', when: string): Field[] => {
  const name = (n: string) => (prefix ? `${prefix}${n[0].toUpperCase()}${n.slice(1)}` : n);
  return [
    { kind: 'range', name: name('duration'), text: 'Each piece takes', min: 0.1, max: 1.5, step: 0.05, unit: 's', when: `${when}own` },
    { kind: 'range', name: name('peak'), text: 'Share of the move to its peak', min: 0.2, max: 1, step: 0.05, unit: '', when: `${when}moving` },
    { kind: 'range', name: name('rise'), text: 'Rise (drop: fall)', min: 0, max: 30, step: 1, unit: ' art px', when: `${when}travel` },
    { kind: 'range', name: name('overshoot'), text: 'Overshoot (drop: dip)', min: 0, max: 6, step: 0.5, unit: ' art px', when: `${when}travel` },
    { kind: 'range', name: name('popFrom'), text: 'Pop from', min: 0, max: 1, step: 0.05, unit: '×', when: `${when}pop` },
    { kind: 'range', name: name('popPeak'), text: 'Pop peak', min: 1, max: 1.5, step: 0.01, unit: '×', when: `${when}pop` },
  ];
};

const tabs: { id: string; text: string; fields: Field[] }[] = [
  {
    id: 'ground',
    text: 'Ground',
    fields: [
      { kind: 'select', name: 'ground', text: 'Order', options: options(GROUND_ORDERS) },
      { kind: 'range', name: 'groundSpan', text: 'Stagger span', min: 0, max: 2.5, step: 0.05, unit: 's' },
      { kind: 'range', name: 'cascade', text: 'Extra left-to-right cascade', min: 0, max: 1, step: 0.05, unit: 's' },
      { kind: 'select', name: 'move', text: 'Move', options: options(MOVES) },
      ...moveFields('', 'g-'),
    ],
  },
  {
    id: 'objects',
    text: 'Objects',
    fields: [
      {
        kind: 'select',
        name: 'with',
        text: 'Arrive',
        options: [
          { value: 'false', text: 'After the ground' },
          { value: 'true', text: 'With the cube under them' },
        ],
      },
      { kind: 'select', name: 'objects', text: 'Order', options: options(OBJECT_ORDERS), when: 'after' },
      { kind: 'range', name: 'objectSpan', text: 'Stagger span', min: 0, max: 2.5, step: 0.05, unit: 's', when: 'after' },
      { kind: 'range', name: 'objectLead', text: 'Start before the ground lands', min: -0.5, max: 1, step: 0.02, unit: 's', when: 'after' },
      { kind: 'range', name: 'lag', text: 'Lag after the cube under them', min: 0, max: 1, step: 0.02, unit: 's', when: 'with' },
      { kind: 'select', name: 'objectMove', text: 'Move', options: options(OBJECT_MOVES) },
      ...moveFields('object', 'o-'),
    ],
  },
];
---

<aside class="entrance-lab" aria-label="Entrance controls">
  <div class="entrance-lab__head">
    <p class="label">Controls</p>
    <p class="entrance-lab__keys"><kbd>R</kbd> replay · <kbd>H</kbd> hide</p>
  </div>
  <div class="entrance-lab__tabs" role="tablist" aria-label="Pieces">
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`entrance-tab-${tab.id}`}
          aria-controls={`entrance-panel-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-tab={tab.id}
        >
          {tab.text}
        </button>
      ))
    }
  </div>
  <form class="entrance-lab__form">
    {
      tabs.map((tab, i) => (
        <div
          class="entrance-lab__panel"
          role="tabpanel"
          id={`entrance-panel-${tab.id}`}
          aria-labelledby={`entrance-tab-${tab.id}`}
          data-panel={tab.id}
          hidden={i !== 0}
        >
          {tab.fields.map((f) =>
            f.kind === 'select' ? (
              <label class="entrance-lab__field" data-when={f.when}>
                <span>{f.text}</span>
                <select name={f.name}>
                  {f.options.map((o) => (
                    <option value={o.value}>{o.text}</option>
                  ))}
                </select>
              </label>
            ) : (
              <label class="entrance-lab__field" data-range={f.name} data-when={f.when}>
                <span>
                  {f.text}: <output data-unit={f.unit} />
                </span>
                <input type="range" name={f.name} min={f.min} max={f.max} step={f.step} />
              </label>
            ),
          )}
          {tab.id === 'objects' && (
            <p class="entrance-lab__note" data-when="o-same">
              The objects move as the ground does. Pick a move to give them their own numbers.
            </p>
          )}
        </div>
      ))
    }
    <label class="entrance-lab__field">
      <span>Playback speed</span>
      <select name="speed">
        <option value="1">1×</option>
        <option value="0.5">½×</option>
        <option value="0.25">¼×</option>
      </select>
    </label>
  </form>
  <p class="entrance-lab__readout" aria-live="polite"></p>
  <div class="entrance-lab__actions">
    <button type="button" class="btn btn--primary" data-act="replay">Replay</button>
    <button type="button" class="btn btn--ghost" data-act="seed">New shuffle</button>
    <button type="button" class="btn btn--ghost" data-act="reset">Site version</button>
    <button type="button" class="btn btn--ghost" data-act="copy">Copy</button>
  </div>
</aside>

<style>
  .entrance-lab {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 16px;
    background: var(--color-page);
    border: var(--border-thick);
    border-radius: var(--radius-panel);
    color: var(--color-ink);
  }
  .entrance-lab.is-hidden {
    display: none;
  }
  .entrance-lab__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }
  .entrance-lab__head p {
    margin: 0;
  }
  .entrance-lab__keys {
    color: var(--color-ink-muted);
    font-size: 0.875rem;
  }
  .entrance-lab__tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 2px solid var(--color-earth);
    border-radius: var(--radius-button);
  }
  .entrance-lab__tabs button {
    min-height: 44px;
    font: inherit;
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-card);
    border: 0;
    border-radius: var(--radius-button);
    cursor: pointer;
  }
  .entrance-lab__tabs button[aria-selected='true'] {
    color: var(--color-on-accent);
    background: var(--color-accent);
  }
  .entrance-lab__form,
  .entrance-lab__panel {
    display: grid;
    gap: 8px;
  }
  .entrance-lab__panel[hidden] {
    display: none;
  }
  .entrance-lab__field {
    display: grid;
    gap: 2px;
    font-size: 0.875rem;
  }
  .entrance-lab__field[hidden],
  .entrance-lab__note[hidden] {
    display: none;
  }
  .entrance-lab__note {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.875rem;
  }
  .entrance-lab select {
    min-height: 44px;
    padding: 0 8px;
    font: inherit;
    color: inherit;
    background: var(--color-card);
    border: 2px solid var(--color-earth);
    border-radius: var(--radius-button);
  }
  .entrance-lab input[type='range'] {
    width: 100%;
    min-height: 32px;
    accent-color: var(--color-accent);
  }
  .entrance-lab output {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .entrance-lab__readout {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.875rem;
  }
  .entrance-lab__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .entrance-lab :focus-visible {
    outline: 3px solid var(--color-gold);
    outline-offset: 2px;
  }
</style>

<script>
  import { motionOf, schedule, settledBy, TIMING, type Timing } from '../../lib/island-entrance.mjs';
  import { play, reduced } from '../../lib/motion';
  import { pieceOf, playEntrance } from '../../lib/play-entrance';

  const lab = document.querySelector<HTMLElement>('.entrance-lab');
  const form = lab?.querySelector<HTMLFormElement>('form');
  const svg = document.querySelector<SVGSVGElement>('.entrance-stage .hero-island');

  if (lab && form && svg) {
    const groups = [...svg.querySelectorAll<SVGGElement>('.enter')];
    const pieces = groups.map(pieceOf);
    const readout = lab.querySelector('.entrance-lab__readout')!;
    const shipped = settledBy(schedule(pieces, TIMING));
    const tabs = [...lab.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

    type Key = keyof Timing;
    const parse = (key: Key, value: string) =>
      typeof TIMING[key] === 'number' ? Number(value) : typeof TIMING[key] === 'boolean' ? value === 'true' : value;

    const q0 = new URLSearchParams(location.search);
    const fromUrl = () => {
      const t: Record<string, unknown> = { ...TIMING };
      for (const key of Object.keys(TIMING) as Key[]) {
        const v = q0.get(key);
        if (v !== null) t[key] = parse(key, v);
      }
      return t as Timing;
    };
    let t = fromUrl();
    let speed = Number(q0.get('speed') ?? 1) || 1;
    let tab = q0.get('tab') === 'objects' ? 'objects' : 'ground';
    let running: ReturnType<typeof playEntrance> = [];

    const run = () => {
      for (const c of running) c?.cancel();
      // A cancelled move can leave its start state behind (a pop's scale, say),
      // so every piece goes back in place before the next run starts.
      play(groups, { opacity: 1, x: 0, y: 0, scale: 1 }, { duration: 0 });
      const plan = schedule(pieces, t);
      running = playEntrance(groups, plan);
      for (const c of running) if (c) c.speed = speed;
      readout.textContent = reduced()
        ? 'Reduced motion is on, so nothing animates.'
        : `Settles by ${settledBy(plan).toFixed(2)}s (the site's: ${shipped.toFixed(2)}s).`;
    };

    const changes = () => (Object.keys(TIMING) as Key[]).filter((key) => t[key] !== TIMING[key]);

    const sync = () => {
      for (const label of form.querySelectorAll<HTMLElement>('[data-range]')) {
        const out = label.querySelector('output')!;
        out.textContent = `${t[label.dataset.range as Key]}${out.dataset.unit}`;
      }
      // Each tab shows the numbers its own move uses. The objects' numbers
      // show only when they have a move of their own.
      const own = t.objectMove !== 'same';
      const uses = (move: string) => ({
        own: true,
        moving: move !== 'fade',
        travel: ['float', 'drop', 'stepped'].includes(move),
        pop: move === 'pop',
      });
      const ground = uses(t.move);
      const object = uses(t.objectMove);
      const show: Record<string, boolean> = {
        after: !t.with,
        with: t.with,
        'o-same': !own,
        ...Object.fromEntries(Object.entries(ground).map(([k, v]) => [`g-${k}`, v])),
        ...Object.fromEntries(Object.entries(object).map(([k, v]) => [`o-${k}`, own && v])),
      };
      for (const field of form.querySelectorAll<HTMLElement>('[data-when]')) field.hidden = !show[field.dataset.when!];
      for (const button of tabs) {
        const on = button.dataset.tab === tab;
        button.setAttribute('aria-selected', String(on));
        button.tabIndex = on ? 0 : -1;
        lab.querySelector<HTMLElement>(`[data-panel="${button.dataset.tab}"]`)!.hidden = !on;
      }
      const q = new URLSearchParams();
      for (const key of changes()) q.set(key, String(t[key]));
      if (speed !== 1) q.set('speed', String(speed));
      if (tab !== 'ground') q.set('tab', tab);
      history.replaceState(null, '', `${location.pathname}${q.size ? `?${q}` : ''}`);
    };

    const fill = () => {
      for (const el of [...form.elements] as (HTMLInputElement | HTMLSelectElement)[]) {
        if (el.name === 'speed') el.value = String(speed);
        else if (el.name in t) el.value = String(t[el.name as Key]);
      }
      sync();
    };

    form.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement | HTMLSelectElement;
      if (el.name === 'speed') speed = Number(el.value);
      else if (el.name === 'objectMove' && t.objectMove === 'same' && el.value !== 'same') {
        // Going from the ground's move to one of their own, the objects start
        // from the ground's numbers, so only the move itself changes at first.
        const g = motionOf(t, 'ground');
        t = {
          ...t,
          objectMove: el.value as Timing['objectMove'],
          objectDuration: g.duration,
          objectPeak: g.peak,
          objectRise: g.rise,
          objectOvershoot: g.overshoot,
          objectPopFrom: g.popFrom,
          objectPopPeak: g.popPeak,
        };
        fill();
      } else t = { ...t, [el.name]: parse(el.name as Key, el.value) };
      sync();
      run();
    });

    const select = (id: string, focus = false) => {
      tab = id;
      sync();
      if (focus) tabs.find((b) => b.dataset.tab === id)?.focus();
    };
    for (const button of tabs) {
      button.addEventListener('click', () => select(button.dataset.tab!));
      button.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        e.preventDefault();
        const i = tabs.indexOf(button);
        select(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length].dataset.tab!, true);
      });
    }

    lab.addEventListener('click', (e) => {
      const act = (e.target as HTMLElement).closest<HTMLButtonElement>('button')?.dataset.act;
      if (act === 'replay') run();
      if (act === 'seed') {
        t = { ...t, seed: t.seed + 1 };
        sync();
        run();
      }
      if (act === 'reset') {
        t = { ...TIMING };
        fill();
        run();
      }
      if (act === 'copy') {
        const list = changes().map((key) => `${key}: ${JSON.stringify(t[key])}`);
        const text = list.length
          ? `Entrance lab: changes to TIMING in src/lib/island-entrance.mjs: { ${list.join(', ')} }`
          : 'Entrance lab: no changes to TIMING in src/lib/island-entrance.mjs';
        void navigator.clipboard?.writeText(text).then(() => (readout.textContent = 'Copied.'));
      }
    });

    addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const key = e.key.toLowerCase();
      if (key === 'r') {
        e.preventDefault();
        run();
      }
      if (key === 'h') {
        e.preventDefault();
        lab.classList.toggle('is-hidden');
      }
    });

    fill();
    run();
  }
</script>
