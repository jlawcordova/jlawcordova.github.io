---
// The achievement icon and frame sheets, inlined once on a page that shows
// achievement rows (gamified accomplishments spec D5; achievements redesign
// spec R10). Each row crops its icon out of the first with
// <svg viewBox="<16 × index> 0 16 16"><use href="#achievement-icons"/></svg>,
// and its frame out of the second with viewBox="<20 × index> 0 20 20" and
// #achievement-frames (AchievementIcon.astro does both). Hidden with a zero
// size, not display:none, because some browsers don't draw <use> from a
// display:none SVG (plan, Risks).
import icons from '../assets/pixel-art/achievement-icons.svg?raw';
import frames from '../assets/pixel-art/achievement-frames.svg?raw';

const inner = (svg: string) => svg.replace(/^\s*<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<svg class="achievement-icons" width="0" height="0" aria-hidden="true" focusable="false">
  <g id="achievement-icons" set:html={inner(icons)} />
  <g id="achievement-frames" set:html={inner(frames)} />
</svg>

{
  /*
   * The rows' tooltip (spec D4, WCAG 1.4.13): CSS shows it on hover or focus;
   * Escape hides it until the pointer or focus leaves the row. Inline and
   * rendered once here, since this component is on every page with rows.
   */
}
<script is:inline>
  (d=>{const l=e=>{const r=e.target.closest?.('.achievement');if(r&&!r.contains(e.relatedTarget))delete r.dataset.tipHidden};d.addEventListener('keydown',e=>{if(e.key==='Escape')for(const r of d.querySelectorAll('.achievement:hover,.achievement:focus-within'))r.dataset.tipHidden=''});d.addEventListener('mouseout',l);d.addEventListener('focusout',l)})(document);
</script>
