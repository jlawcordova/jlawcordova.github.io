---
import rangeSprite from '../../assets/pixel-art/range-sprite.svg?raw';
import { rangeClasses } from '../../data/home';

// Inline so the section's data-current can switch outfit variants in CSS.
const sprite = rangeSprite.replace('<svg ', '<svg class="range__sprite-art pixel-art" ');
const [first] = rangeClasses;
---

<section id="range" class="range" data-current="0" aria-labelledby="range-title">
  <div class="range__inner">
    <div class="range__panel">
      <div class="range__stage isogrid">
        <p class="range__nameplate" aria-live="off" style={`--class-shadow: ${first.shadow}`}>
          <span class="range__name">{first.name}</span><span class="visually-hidden range__position"
            >, class 1 of {rangeClasses.length}</span
          >
        </p>
        <div class="range__controls">
          <button type="button" class="range__arrow" data-dir="-1" aria-label="Previous class">
            <svg class="pixel-art" width="28" height="36" viewBox="0 0 7 9" aria-hidden="true">
              <path fill="currentColor" d="M5 0h2v9h-2zM3 1h2v7h-2zM1 3h2v3h-2zM0 4h1v1h-1z"></path>
            </svg>
          </button>
          <figure class="range__sprite" role="img" aria-label={`Pixel-art character dressed for ${first.name}`}>
            <Fragment set:html={sprite} />
          </figure>
          <button type="button" class="range__arrow" data-dir="1" aria-label="Next class">
            <svg class="pixel-art" width="28" height="36" viewBox="0 0 7 9" aria-hidden="true">
              <path fill="currentColor" d="M0 0h2v9h-2zM2 1h2v7h-2zM4 3h2v3h-2zM6 4h1v1h-1z"></path>
            </svg>
          </button>
        </div>
        <div class="range__pager">
          {rangeClasses.map((_, i) => <span class:list={['range__dot', { 'is-current': i === 0 }]} aria-hidden="true" />)}
          <button type="button" class="range__toggle" aria-pressed="false" aria-label="Pause class rotation">
            <svg class="pixel-art range__icon-pause" width="20" height="28" viewBox="0 0 5 7" aria-hidden="true">
              <path fill="currentColor" d="M0 0h2v7h-2zM3 0h2v7h-2z"></path>
            </svg>
            <svg class="pixel-art range__icon-play" width="20" height="28" viewBox="0 0 5 7" aria-hidden="true">
              <path fill="currentColor" d="M0 0h1v7h-1zM1 1h1v5h-1zM2 2h1v3h-1zM3 3h1v1h-1z"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
    <div class="range__copy">
      <h2 id="range-title">Many hats. <span class="gold">One craftsman.</span></h2>
      <p>
        I’ve worked every stage of shipping software, from code review to production sign-off. AI speeds up the work;
        the judgment stays mine.
      </p>
    </div>
  </div>
</section>

<script>
  import { rangeClasses } from '../../data/home';

  const section = document.querySelector<HTMLElement>('.range');
  if (section) {
    const $ = <T extends Element>(selector: string) => section.querySelector<T>(selector)!;
    const plate = $<HTMLElement>('.range__nameplate');
    const sprite = $('.range__sprite');
    const next = $<HTMLElement>('[data-dir="1"]');
    const toggle = $<HTMLButtonElement>('.range__toggle');
    const panel = $('.range__panel');
    const dots = section.querySelectorAll('.range__dot');
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const count = rangeClasses.length;
    let [index, playing, hovered, focused] = [0, !motion.matches, false, false];
    let timer: ReturnType<typeof setInterval> | undefined;
    let pulse: ReturnType<typeof setTimeout> | undefined;

    // User-triggered changes are announced; auto-advance isn't.
    const show = (step: number, announce: boolean) => {
      index = (index + step + count) % count;
      const { name, shadow } = rangeClasses[index];
      plate.setAttribute('aria-live', announce ? 'polite' : 'off');
      section.dataset.current = String(index);
      $('.range__name').textContent = name;
      $('.range__position').textContent = `, class ${index + 1} of ${count}`;
      plate.style.setProperty('--class-shadow', shadow);
      sprite.setAttribute('aria-label', `Pixel-art character dressed for ${name}`);
      dots.forEach((dot, i) => dot.classList.toggle('is-current', i === index));
    };

    const schedule = () => {
      clearInterval(timer);
      toggle.setAttribute('aria-pressed', String(!playing));
      if (!playing || hovered || focused || document.hidden) return;
      timer = setInterval(() => {
        show(1, false);
        if (motion.matches) return;
        next.classList.add('is-pulsing');
        clearTimeout(pulse);
        pulse = setTimeout(() => next.classList.remove('is-pulsing'), 200);
      }, 2200);
    };

    section.querySelectorAll<HTMLElement>('.range__arrow').forEach((arrow) =>
      arrow.addEventListener('click', () => (show(Number(arrow.dataset.dir), true), schedule())),
    );
    toggle.addEventListener('click', () => ((playing = !playing), schedule()));
    panel.addEventListener('mouseenter', () => ((hovered = true), schedule()));
    panel.addEventListener('mouseleave', () => ((hovered = false), schedule()));
    panel.addEventListener('focusin', () => ((focused = true), schedule()));
    panel.addEventListener('focusout', (e) => ((focused = panel.contains((e as FocusEvent).relatedTarget as Node)), schedule()));
    motion.addEventListener('change', () => ((playing = !motion.matches), schedule()));
    document.addEventListener('visibilitychange', schedule);

    section.classList.add('is-ready');
    schedule();
  }
</script>
