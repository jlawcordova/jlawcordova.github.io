---
import rangeSprite from '../../assets/pixel-art/range-sprite.svg?raw';
import { rangeClasses } from '../../data/home';

// Inline so the section's data-current can switch outfit variants in CSS.
const sprite = rangeSprite.replace('<svg ', '<svg class="range__sprite-art pixel-art" ');
const [first] = rangeClasses;
---

<!-- --class-shadow tints the section, the screen, the swatch and the countdown (Range pop spec R1). -->
<section id="range" class="range" data-current="0" aria-labelledby="range-title" style={`--class-shadow: ${first.shadow}`}>
  <!-- The class change's layer: the old color, cut away by a slash. -->
  <div class="range__change" aria-hidden="true"></div>
  <div class="range__inner">
    <div class="range__copy">
      <h2 id="range-title">Many hats. <span class="gold">One craftsman.</span></h2>
      <p>
        These are the disciplines I work in, from Figma designs to production releases. I set up AI workflows that plan,
        build and check each change before it ships.
      </p>
    </div>
    <!-- A drawn object: it keeps its light colors in the dark theme (dark mode spec R8). -->
    <div class="range__console" data-theme="light">
      <div class="range__bezel">
        <div class="range__stage isogrid">
          <!-- The class change's layer on the screen: the old color, broken into battle bars. -->
          <div class="range__change" aria-hidden="true"></div>
          <p class="range__nameplate" aria-live="off">
            <span class="range__swatch" aria-hidden="true"></span><span class="range__name">{first.name}</span><span
              class="visually-hidden range__position">, class 1 of {rangeClasses.length}</span
            >
          </p>
          <figure class="range__sprite" role="img" aria-label={`Pixel-art character dressed for ${first.name}`}>
            <Fragment set:html={sprite} />
          </figure>
          <!-- PAUSED, top right, while START has the rotation paused. START's aria-pressed says the same. -->
          <span class="range__paused" aria-hidden="true">
            <svg class="pixel-art" width="6" height="8" viewBox="0 0 3 4">
              <path fill="currentColor" d="M0 0h1v4h-1zM2 0h1v4h-1z"></path>
            </svg>
            <span class="range__paused-label">Paused</span>
          </span>
          <!-- The screen's HUD: the countdown to the next class, in segments, with no numbers. -->
          <div class="range__hud" aria-hidden="true">
            <div class="range__timer"><span class="range__timer-track"><span class="range__timer-fill"></span></span></div>
          </div>
        </div>
      </div>
      <div class="range__controls">
        <!-- A 3 × 3 D-pad: left and right are the class buttons, the rest is plastic. -->
        <div class="range__dpad">
          <span aria-hidden="true"></span>
          <span class="range__dpad-arm" aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <button type="button" class="range__arrow" data-dir="-1" aria-label="Previous class">
            <svg class="pixel-art" width="12" height="15" viewBox="0 0 4 5" aria-hidden="true">
              <path fill="currentColor" d="M3 0h1v5h-1zM2 1h1v3h-1zM1 2h1v1h-1z"></path>
            </svg>
          </button>
          <span class="range__dpad-arm range__dpad-hub" aria-hidden="true"></span>
          <button type="button" class="range__arrow" data-dir="1" aria-label="Next class">
            <svg class="pixel-art" width="12" height="15" viewBox="0 0 4 5" aria-hidden="true">
              <path fill="currentColor" d="M0 0h1v5h-1zM1 1h1v3h-1zM2 2h1v1h-1z"></path>
            </svg>
          </button>
          <span aria-hidden="true"></span>
          <span class="range__dpad-arm" aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </div>
        <button type="button" class="range__toggle" aria-pressed="false" aria-label="Start: pause the class rotation">
          <span class="range__slot" aria-hidden="true"></span>
          <span class="range__key-label" aria-hidden="true">START</span>
        </button>
        <!-- A over B, set off like a handheld's face buttons. Their names say what they do. -->
        <div class="range__ab">
          <button type="button" class="range__button range__a" aria-label="A: jump">A</button>
          <button type="button" class="range__button range__b" data-dir="-1" aria-label="B: previous class">B</button>
        </div>
      </div>
      <div class="range__speaker" aria-hidden="true">
        {Array.from({ length: 5 }, () => <span />)}
      </div>
    </div>
  </div>
</section>

<script>
  import { rangeClasses } from '../../data/home';
  import { RANGE_TIMING, schedule as buildSchedule } from '../../lib/island-entrance.mjs';
  import { play, reduced, reveal } from '../../lib/motion';
  import { pieceOf, playEntrance } from '../../lib/play-entrance';
  import { BARS, barsFrame, barsOrder, INTERVAL, SLASH } from '../../lib/range-change.mjs';

  const section = document.querySelector<HTMLElement>('.range');
  if (section) {
    const $ = <T extends Element>(selector: string) => section.querySelector<T>(selector)!;
    const plate = $<HTMLElement>('.range__nameplate');
    const sprite = $('.range__sprite');
    const stage = $<HTMLElement>('.range__stage');
    const art = $('.range__sprite-art');
    const next = $<HTMLElement>('[data-dir="1"]');
    const toggle = $<HTMLButtonElement>('.range__toggle');
    const panel = $('.range__console');
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const count = rangeClasses.length;
    let [index, playing, focused] = [0, !motion.matches, false];
    let pulse: ReturnType<typeof setTimeout> | undefined;

    // Each change layer runs one change at a time: a new one clears the last.
    const layers = new Map<HTMLElement, ReturnType<typeof setInterval>>();
    const layerOf = (host: HTMLElement) => {
      const layer = host.querySelector<HTMLElement>(':scope > .range__change')!;
      clearInterval(layers.get(layer));
      layer.replaceChildren();
      return layer;
    };

    // Battle bars on the screen (Range pop spec R2): the old color holds in
    // blocks, two rows to a band, and alternate bands sweep away from opposite
    // sides. The blocks just ahead of the sweep light up in the class's bright
    // color. A canvas draws them, one canvas pixel to a block.
    const bars = (from: string) => {
      const layer = layerOf(stage);
      const lit = getComputedStyle(layer).color;
      const cols = Math.ceil(stage.clientWidth / BARS.cell);
      const rows = Math.ceil(stage.clientHeight / BARS.cell);
      const canvas = document.createElement('canvas');
      Object.assign(canvas, { width: cols, height: rows });
      canvas.style.width = `${cols * BARS.cell}px`;
      canvas.style.height = `${rows * BARS.cell}px`;
      layer.append(canvas);
      const ctx = canvas.getContext('2d')!;
      const order = Array.from({ length: cols * rows }, (_, n) => barsOrder(n % cols, Math.floor(n / cols), cols, rows));
      let frame = 0;
      const draw = () => {
        if (frame > BARS.frames) {
          clearInterval(layers.get(layer));
          canvas.remove();
          return;
        }
        ctx.clearRect(0, 0, cols, rows);
        barsFrame(order, frame / BARS.frames).forEach((block, n) => {
          if (!block) return;
          ctx.fillStyle = block === 2 ? lit : from;
          ctx.fillRect(n % cols, Math.floor(n / cols), 1, 1);
        });
        frame += 1;
      };
      draw();
      layers.set(layer, setInterval(draw, BARS.frameMs));
    };

    // A slash across the section (R3): the new color cuts in on a diagonal over
    // the old one and widens until it covers the section.
    const slash = (from: string, to: string) => {
      const layer = layerOf(section);
      const [old, cut] = [from, to].map((color) => {
        const veil = document.createElement('span');
        veil.style.backgroundColor = color;
        return veil;
      });
      layer.append(old, cut);
      cut
        .animate({ clipPath: [SLASH.from, SLASH.to] }, { duration: SLASH.duration, easing: SLASH.easing, fill: 'forwards' })
        .finished.then(() => (old.remove(), cut.remove()))
        .catch(() => {});
    };

    let building: ReturnType<typeof play>[] = [];

    // The current class's setting builds itself, as the hero island does (Range
    // settings spec R4–R6): its floor rows float up left to right, then its
    // objects and the character, by x. A running build completes first, so a
    // quick double press never leaves a piece half-risen.
    const build = () => {
      building.forEach((a) => a?.complete());
      const groups = [...art.querySelectorAll<SVGGElement>(`g[data-class="${index}"] .enter`)];
      building = playEntrance(groups, buildSchedule(groups.map(pieceOf), RANGE_TIMING));
    };

    // User-triggered changes are announced; auto-advance isn't.
    const show = (step: number, announce: boolean) => {
      index = (index + step + count) % count;
      const { name, shadow } = rangeClasses[index];
      const was = { screen: getComputedStyle(stage).backgroundColor, ground: getComputedStyle(section).backgroundColor };
      plate.setAttribute('aria-live', announce ? 'polite' : 'off');
      section.dataset.current = String(index);
      $('.range__name').textContent = name;
      $('.range__position').textContent = `, class ${index + 1} of ${count}`;
      section.style.setProperty('--class-shadow', shadow);
      sprite.setAttribute('aria-label', `Pixel-art character dressed for ${name}`);
      // The new colors are already in place underneath; the changes take the old ones away.
      if (!reduced()) {
        bars(was.screen);
        slash(was.ground, getComputedStyle(section).backgroundColor);
      }
      // The new class's setting builds itself, and the plate pops.
      build();
      play(plate, { scale: [0.88, 1.06, 1] }, { duration: 0.2, ease: 'easeOut' });
    };

    // The countdown is the clock (R4): when it fills, the next class shows.
    // It fills smoothly behind its twelve-segment mask. Keyboard focus in the
    // console and a hidden tab hold it where it is, START pauses it, and a
    // press of an arrow or B starts it over. Hovering doesn't hold it (R4). It's
    // made the first time the rotation plays, so under reduced motion, where
    // the rotation starts paused, nothing runs.
    let countdown: Animation | undefined;
    const clock = () => {
      if (!countdown) {
        countdown = $<HTMLElement>('.range__timer-fill').animate(
          { transform: ['scaleX(0)', 'scaleX(1)'] },
          { duration: INTERVAL, easing: 'linear', fill: 'both' },
        );
        advance(countdown);
      }
      return countdown;
    };
    const schedule = () => {
      toggle.setAttribute('aria-pressed', String(!playing));
      section.classList.toggle('is-paused', !playing);
      if (playing && !focused && !document.hidden) clock().play();
      else countdown?.pause();
    };
    const restart = () => {
      if (countdown) countdown.currentTime = 0;
      schedule();
    };
    // Starting over makes a new finished promise, so wait on it again each time.
    const advance = (run: Animation): Promise<void> =>
      run.finished.then(() => {
        show(1, false);
        restart();
        advance(run);
        if (motion.matches) return;
        next.classList.add('is-pulsing');
        clearTimeout(pulse);
        pulse = setTimeout(() => next.classList.remove('is-pulsing'), 200);
      });

    // The D-pad's arrows, and B, which goes back like Previous.
    section.querySelectorAll<HTMLElement>('button[data-dir]').forEach((arrow) =>
      arrow.addEventListener('click', () => (show(Number(arrow.dataset.dir), true), restart())),
    );
    // START plays at once (R5). Pressed from the keyboard, focus is still on
    // START and would hold the countdown, so pressing START to play lets go of
    // that hold until focus moves again.
    toggle.addEventListener('click', () => {
      playing = !playing;
      if (playing) focused = false;
      schedule();
    });
    // Only keyboard focus holds it, so someone tabbing through the keys isn't
    // moved on mid-way. A click leaves focus on a key without :focus-visible,
    // which doesn't.
    panel.addEventListener('focusin', (e) => ((focused = (e.target as Element).matches(':focus-visible')), schedule()));
    panel.addEventListener('focusout', (e) => {
      if (panel.contains((e as FocusEvent).relatedTarget as Node)) return;
      focused = false;
      schedule();
    });
    motion.addEventListener('change', () => ((playing = !motion.matches), schedule()));
    document.addEventListener('visibilitychange', schedule);

    // A: only the character hops (R6), with chop in pixel-art.css. Its
    // setting stays put, and the class stays. A press mid-hop starts it over.
    $('.range__a').addEventListener('click', () => {
      const character = art.querySelector(`g[data-class="${index}"] .cbob`);
      if (!character || reduced()) return;
      character.classList.remove('is-hopping');
      character.getBoundingClientRect();
      character.classList.add('is-hopping');
      character.addEventListener('animationend', () => character.classList.remove('is-hopping'), { once: true });
    });

    section.classList.add('is-ready');
    schedule();
    // Last, so the controls work even if the entrance can't run.
    reveal([panel], { y: 48, duration: 0.4 });
    // The first setting builds when the stage first comes into view.
    const firstView = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        firstView.disconnect();
        build();
      },
      { threshold: 0.5 },
    );
    firstView.observe(art);
  }
</script>
