---
import HeroIsland from './HeroIsland.astro';
import { heroCopy } from '../../data/home';
import { site } from '../../site';
---

<section id="top" class="hero isogrid">
  <div class="hero__inner">
    <div class="hero__copy">
      <h1 class="hero__title">{heroCopy.title} <span class="accent">{heroCopy.accent}</span></h1>
      <p class="hero__lede">{heroCopy.lede}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#range">Press start</a>
        <a class="btn btn--ghost" href={site.author.linkedin}>Get in touch</a>
      </div>
    </div>
    <!-- Two wrappers, so the entrance and the floaty loop don't fight over one transform. -->
    <div class="hero__art">
      <div class="hero__float floaty">
        <HeroIsland />
      </div>
    </div>
  </div>
</section>

<script>
  // The hero's entrance (pixel-first look spec, Hero): the copy staggers in,
  // and the island builds itself from its enter groups (island sweep drop and
  // island edge sweep specs). Each start state is set by the call that animates it, and nothing
  // runs under reduced motion.
  import { schedule, TIMING } from '../../lib/island-entrance.mjs';
  import { easeOut, play, stagger } from '../../lib/motion';
  import { pieceOf, playEntrance } from '../../lib/play-entrance';

  const hero = document.querySelector('.hero');
  if (hero) {
    const copy = [...hero.querySelectorAll('.hero__title, .hero__lede, .hero__actions')];
    play(copy, { opacity: [0, 1], y: [16, 0] }, { duration: 0.4, delay: stagger(0.08), ease: easeOut });
    const groups = [...hero.querySelectorAll<SVGGElement>('.hero-island .enter')];
    playEntrance(groups, schedule(groups.map(pieceOf), TIMING));
  }
</script>
