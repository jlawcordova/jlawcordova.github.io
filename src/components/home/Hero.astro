---
import HeroIsland from './HeroIsland.astro';
import { site } from '../../site';
---

<section id="top" class="hero isogrid">
  <div class="hero__inner">
    <div class="hero__copy">
      <h1 class="hero__title">I take software from estimate <span class="accent">to production.</span></h1>
      <p class="hero__lede">
        Senior developer and tech lead in Davao City. I lead full-stack teams, design data platforms on Microsoft Fabric, and
        run releases with sign-offs and rollback.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#range">Press start</a>
        <a class="btn btn--ghost" href={site.author.linkedin}>Get in touch</a>
      </div>
    </div>
    <!-- Two wrappers, so the entrance and the floaty loop don't fight over one transform. -->
    <div class="hero__art">
      <div class="hero__float floaty">
        <HeroIsland />
      </div>
    </div>
  </div>
</section>

<script>
  // The hero's entrance (pixel-first look spec, Hero): the copy staggers in,
  // and the island builds itself from its enter groups (island build entrance
  // spec). Each start state is set by the call that animates it, and nothing
  // runs under reduced motion.
  import { schedule, SETTLE_EASE } from '../../lib/island-entrance.mjs';
  import { easeOut, play, stagger } from '../../lib/motion';

  const hero = document.querySelector('.hero');
  if (hero) {
    const copy = [...hero.querySelectorAll('.hero__title, .hero__lede, .hero__actions')];
    play(copy, { opacity: [0, 1], y: [16, 0] }, { duration: 0.4, delay: stagger(0.08), ease: easeOut });
    const groups = [...hero.querySelectorAll<SVGGElement>('.hero-island .enter')];
    const entrances = schedule(
      groups.map((g) => ({ enter: g.dataset.enter, row: Number(g.dataset.row), x: Number(g.dataset.x) })),
    );
    groups.forEach((group, i) => {
      const entrance = entrances[i];
      if (!entrance) return;
      const { keyframes, delay, duration, times, move } = entrance;
      play(group, keyframes, { delay, duration, times, ease: move === 'float' ? [easeOut, SETTLE_EASE] : easeOut });
    });
  }
</script>
