---
import PageHead from './PageHead.astro';
import PostListItem from './PostListItem.astro';
import type { Post } from '../lib/posts';
import { pagePath as pathUnder, type Page } from '../lib/pagination';

type Props = Page<Post>;

const { items: posts, page, totalPages, totalItems: totalPosts } = Astro.props;
const pagePath = (n: number) => pathUnder('/blog/', n);
// Page 1 leads with the newest post as a featured card.
const featured = page === 1 ? posts[0] : undefined;
const rest = featured ? posts.slice(1) : posts;
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

<PageHead title="Blog" label={`${totalPosts} posts · Page ${page} of ${totalPages}`} />

<div class="page-body">
  <div class="page-body__inner blog">
    {
      featured && (
        <article class="featured-post">
          <a class="featured-post__image" href={featured.url} tabindex="-1" aria-hidden="true">
            <img src={featured.featuredImage} alt="" />
          </a>
          <div class="featured-post__body">
            <p class="label">{featured.category}</p>
            <h2 class="featured-post__title">
              <a href={featured.url}>{featured.title}</a>
            </h2>
            {featured.description && <p class="featured-post__description">{featured.description}</p>}
            <a class="btn btn--primary" href={featured.url}>
              Read more<span class="visually-hidden">: {featured.title}</span>
            </a>
          </div>
        </article>
      )
    }

    {
      rest.length > 0 && (
        <ol class="post-list" role="list">
          {rest.map((post) => (
            <PostListItem post={post} />
          ))}
        </ol>
      )
    }

    {
      totalPages > 1 && (
        <nav class="pagination" aria-label="Blog pages">
          {page > 1 && (
            <a class="pagination__link" href={pagePath(page - 1)} rel="prev">
              Prev
            </a>
          )}
          {pages.map((n) => (
            <a
              class="pagination__link"
              href={pagePath(n)}
              aria-current={n === page ? 'page' : undefined}
              aria-label={`Page ${n}`}
            >
              {n}
            </a>
          ))}
          {page < totalPages && (
            <a class="pagination__link" href={pagePath(page + 1)} rel="next">
              Next
            </a>
          )}
        </nav>
      )
    }
  </div>
</div>
