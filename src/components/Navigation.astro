---
import JLMark from './JLMark.astro';
import { getAccomplishments, homeSelection } from '../lib/accomplishments';
import { site } from '../site';

// On the home page the brand scrolls back to the hero instead of reloading.
const home = Astro.url.pathname === '/';
// Lately points at the home page's accomplishments section, so it shows only
// when that section renders (pixel-first look spec, Shell).
const lately = homeSelection(getAccomplishments()).visible;
---

<header class="site-header">
  <nav class="site-nav" aria-label="Main">
    <a class="site-nav__brand" href={home ? '#top' : '/'}><JLMark height={23} /> J. LAW. Cordova</a>
    <button class="site-nav__menu" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Open menu">
      <svg class="site-nav__glyph-open" width="21" height="18" viewBox="0 0 7 6" aria-hidden="true" shape-rendering="crispEdges">
        <path fill="currentColor" d="M0 0h7v1h-7zM0 2.5h7v1h-7zM0 5h7v1h-7z"></path>
      </svg>
      <svg class="site-nav__glyph-close" width="18" height="18" viewBox="0 0 6 6" aria-hidden="true" shape-rendering="crispEdges">
        <path fill="currentColor" d="M0 0h1v1h-1zM5 0h1v1h-1zM1 1h1v1h-1zM4 1h1v1h-1zM2 2h2v2h-2zM1 4h1v1h-1zM4 4h1v1h-1zM0 5h1v1h-1zM5 5h1v1h-1z"></path>
      </svg>
    </button>
    <div class="site-nav__links" id="site-menu">
      <a href="/#range">Range</a>
      {lately && <a href="/#accomplishments">Lately</a>}
      <a href="/blog/">Blog</a>
      <a class="pill" href={site.author.linkedin}>Contact</a>
    </div>
    <!-- The theme toggle (dark mode spec R5): a half-filled pixel square in light, a pixel sun in dark. -->
    <button class="site-nav__theme" type="button" aria-pressed="false" aria-label="Dark theme">
      <svg class="site-nav__glyph-dark" width="21" height="21" viewBox="0 0 7 7" aria-hidden="true" shape-rendering="crispEdges">
        <path fill="currentColor" d="M0 0h7v1h-7zM0 6h7v1h-7zM6 1h1v5h-1zM0 1h4v5h-4z"></path>
      </svg>
      <svg class="site-nav__glyph-light" width="21" height="21" viewBox="0 0 7 7" aria-hidden="true" shape-rendering="crispEdges">
        <path fill="currentColor" d="M0 0h1v1h-1zM3 0h1v1h-1zM6 0h1v1h-1zM2 2h3v3h-3zM0 3h1v1h-1zM6 3h1v1h-1zM0 6h1v1h-1zM3 6h1v1h-1zM6 6h1v1h-1z"></path>
      </svg>
    </button>
  </nav>
</header>

<script>
  // The theme toggle (dark mode spec R2–R5, R9). BaseLayout's pre-paint script
  // has already set <html data-theme> from the saved choice or the system
  // setting; this keeps the buttons, theme-color and later changes in step.
  const root = document.documentElement;
  const system = matchMedia('(prefers-color-scheme: dark)');
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  const saved = () => {
    try {
      const theme = localStorage.getItem('theme');
      return theme === 'light' || theme === 'dark' ? theme : null;
    } catch {
      return null; // Storage blocked: follow the system.
    }
  };
  const apply = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    for (const button of document.querySelectorAll('.site-nav__theme')) button.setAttribute('aria-pressed', String(theme === 'dark'));
    themeColor?.setAttribute('content', getComputedStyle(root).getPropertyValue('--color-page').trim());
  };

  apply(root.dataset.theme === 'dark' ? 'dark' : 'light');
  for (const button of document.querySelectorAll('.site-nav__theme')) {
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Not saved; it still applies to this page.
      }
      apply(next);
    });
  }
  system.addEventListener('change', (event) => {
    if (!saved()) apply(event.matches ? 'dark' : 'light');
  });
  // A choice made in another tab.
  addEventListener('storage', (event) => {
    if (event.key === 'theme') apply(saved() ?? (system.matches ? 'dark' : 'light'));
  });

  // The small-screen menu (pixel-first look spec R7). Motion loads only once
  // someone reaches for the button, so pages without an island don't fetch it
  // unless the menu is used. Until it's loaded, the links show at once.
  type MotionModule = typeof import('../lib/motion');

  const narrow = matchMedia('(max-width: 720px)');

  for (const nav of document.querySelectorAll<HTMLElement>('.site-nav')) {
    const button = nav.querySelector<HTMLButtonElement>('.site-nav__menu');
    const links = nav.querySelector<HTMLElement>('.site-nav__links');
    if (!button || !links) continue;

    let motion: MotionModule | undefined;
    let loading = false;
    const load = () => {
      if (loading) return;
      loading = true;
      import('../lib/motion').then(
        (module) => (motion = module),
        () => undefined, // The links still show, just without the stagger.
      );
    };
    for (const type of ['pointerenter', 'focus', 'touchstart'] as const) {
      button.addEventListener(type, load, { once: true, passive: true });
    }

    const isOpen = () => nav.classList.contains('is-open');
    const setOpen = (open: boolean) => {
      nav.classList.toggle('is-open', open);
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open && motion) {
        const { play, stagger, easeOut } = motion;
        play([...links.children], { opacity: [0, 1], y: [-8, 0] }, { duration: 0.2, delay: stagger(0.04), ease: easeOut });
      }
    };

    button.addEventListener('click', () => setOpen(!isOpen()));
    links.addEventListener('click', (event) => {
      if (isOpen() && event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !isOpen()) return;
      setOpen(false);
      button.focus();
    });
    document.addEventListener('click', (event) => {
      if (isOpen() && event.target instanceof Node && !nav.contains(event.target)) setOpen(false);
    });
    narrow.addEventListener('change', () => {
      if (!narrow.matches && isOpen()) setOpen(false);
    });
  }
</script>
