    "test": "node --test \"scripts/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/prism": "4.0.2",
    "astro": "7.3.5",
    "motion": "14.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "pixellab": "github:jlawcordova/jlawcordova-lab#v0.5.0",
    "typescript": "6.0.3"
  }
}
