{
  "name": "jlawcordova-site",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run art && astro dev",
    "build": "npm run art && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "fetch-accomplishments": "node scripts/fetch-accomplishments.mjs",
    "art": "node scripts/pixellab.mjs art build --site .",
    "pixellab": "node scripts/pixellab.mjs --site .",
    "explainer-export": "node scripts/export-explainer-library.mjs",
    "diagrams": "node scripts/diagrams/render.mjs",
    "e2e": "node scripts/e2e/run.mjs",
    "test": "npm run art && node --test \"scripts/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/prism": "4.0.2",
    "astro": "7.3.5",
    "motion": "14.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
