{
  "name": "jlawcordova-site",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "fetch-accomplishments": "node scripts/fetch-accomplishments.mjs",
    "art": "pixellab art build --site .",
